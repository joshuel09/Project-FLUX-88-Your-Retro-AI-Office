# FLUX-88 environment configuration
# Copy to .env — the defaults below run the full MVP locally with ZERO paid credentials.
# (This file is named env.example without a leading dot so tooling that protects
#  .env* files never touches it. Usage: cp env.example .env)

# --- Core services -----------------------------------------------------------
DATABASE_URL=postgres://flux88:flux88_local_dev@localhost:5488/flux88
REDIS_URL=redis://localhost:6388
API_PORT=3001
WEB_URL=http://localhost:3000

# Session signing secret — generate your own: `openssl rand -hex 32`
SESSION_SECRET=change-me-generate-a-real-random-value

# --- LLM provider ------------------------------------------------------------
# Mock mode is the default; no API key required.
MOCK_LLM=true
# Only used when MOCK_LLM=false (Phase 2+). Never commit a real key.
# ANTHROPIC_API_KEY=

# --- Connectors (all mocked by default; Phase 3+) ----------------------------
GITHUB_CONNECTOR=mock
DISCORD_CONNECTOR=mock
TRELLO_CONNECTOR=mock
# GITHUB_TOKEN=
# DISCORD_BOT_TOKEN=
# DISCORD_OWNER_USER_ID=
# TRELLO_API_KEY=
# TRELLO_TOKEN=

# --- Behavior ----------------------------------------------------------------
QUIET_HOURS=22:00-07:00
MAX_PARALLEL_AGENT_RUNS=3
