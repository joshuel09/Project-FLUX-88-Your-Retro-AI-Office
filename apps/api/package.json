{
  "name": "@flux88/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/**/*.integration.test.ts"
  },
  "dependencies": {
    "@flux88/agents": "workspace:*",
    "@flux88/config": "workspace:*",
    "@flux88/core": "workspace:*",
    "@flux88/db": "workspace:*",
    "@hono/node-server": "^1.13.8",
    "@node-rs/argon2": "^2.0.2",
    "hono": "^4.6.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
