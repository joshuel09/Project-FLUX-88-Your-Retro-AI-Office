{
  "name": "@flux88/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --no-file-parallelism .integration.test.ts"
  },
  "dependencies": {
    "@flux88/agents": "workspace:*",
    "@flux88/config": "workspace:*",
    "@flux88/core": "workspace:*",
    "@flux88/db": "workspace:*",
    "@flux88/llm": "workspace:*",
    "@flux88/memory": "workspace:*",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.38.3",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
